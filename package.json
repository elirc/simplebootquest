{
  "name": "simplebootquest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @sbq/api\" \"npm run dev -w @sbq/web\"",
    "build": "npm run build -w @sbq/web && npm run build -w @sbq/api",
    "start": "npm run start -w @sbq/api",
    "test": "npm run test --workspaces --if-present && npm run validate:content",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate:content": "tsx scripts/validate-content.ts",
    "db:migrate": "npm run db:migrate -w @sbq/api",
    "db:deploy": "npm run db:deploy -w @sbq/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "@sbq/curriculum": "0.1.0",
    "@sbq/runner": "0.1.0",
    "sql.js": "^1.13.0"
  },
  "engines": {
    "node": ">=20"
  }
}
